#!/usr/bin/env bash
# A push is an explicit act: PUBLISH_OK=1 must be set by the person pushing. Then the publish gate and the CPU suite.
[ "${PUBLISH_OK:-}" = 1 ] || { echo "refusing push: set PUBLISH_OK=1"; exit 1; }
cd "$(git rev-parse --show-toplevel)" && tools/publish-check.sh && tests/run.sh --cpu
