# heaptide run [--gpu] [--py] [--py-depth N] [--every MS] [--snapshot-every S] [--gpu-timeline all|sites,streams,frag] [--out DIR] -- CMD...
# heaptide report DIR [args]   |   heaptide snapshot DIR (running process writes a report now)
# heaptide attach PID [--out DIR]   (a running process: gdb loads heaptide into it; root under Yama 1)
# heaptide diff BASE_DIR NEW_DIR [--fail-on new|grown|none] [--json] [--top N]   (exit 1: a new leak site)
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
case "${1:-}" in
  report) shift; exec "$here/build/heaptide_report" "$@" ;;
  snapshot) [[ -d ${2:-} ]] || { echo "FAIL heaptide: snapshot needs the run's --out DIR" >&2; exit 2; }
            : > "$2/snapshot"; echo "heaptide: snapshot requested; the process writes it within --every ms" >&2; exit 0 ;;
  diff) [[ -d ${2:-} && -d ${3:-} ]] || { echo "FAIL heaptide: diff needs two report DIRs" >&2; exit 2; }
        t=$(mktemp -d "${TMPDIR:-/tmp}/heaptide-diff.XXXXXX"); trap 'rm -rf "$t"' EXIT; top=(); [[ ${4:-} == --top ]] && top=(--top "$5")
        for x in 2 3; do "$here/build/heaptide_report" "${!x}" --fail-on none "${top[@]}" --sites "$t/$x" >/dev/null || exit 2; done
        "$here/build/heaptide_report" --diff "$t/2" "$t/3" "${@:4}"; exit $? ;;
  attach) [[ ${2:-} =~ ^[0-9]+$ ]] || { echo "FAIL heaptide: attach PID [--out DIR]" >&2; exit 2; }
          out=${4:-.work/heaptide}; [[ ${3:-} == --out || -z ${3:-} ]] || { echo "FAIL heaptide: attach PID [--out DIR]" >&2; exit 2; }
          mkdir -p "$out"; o=$(readlink -f "$out")
          r=$(gdb -p "$2" -batch -nx -ex "call (int)setenv(\"HEAPTIDE_OUT\",\"$o\",1)" -ex 'call (int)setenv("HEAPTIDE_ATTACH","1",1)' \
                -ex "call (void*)dlopen(\"$here/build/libheaptide.so\",2)" 2>&1) || true
          grep -q '^\$3 = (void \*) 0x[1-9a-f]' <<<"$r" || { echo "FAIL heaptide: attach to $2 failed (Yama ptrace_scope $(cat /proc/sys/kernel/yama/ptrace_scope 2>/dev/null || echo ?): run it with sudo, or as the process's parent)" >&2
            grep -iE 'ptrace|denied|error|No symbol' <<<"$r" | head -3 >&2; exit 2; }
          echo "heaptide: attached to $2; heaptide snapshot $o, or the report at its exit" >&2; exit 0 ;;
  run) shift ;;
  *) echo "usage: heaptide run [--gpu] [--py] [--py-depth N] [--every MS] [--snapshot-every S] [--gpu-timeline PARTS] [--out DIR] -- CMD... | heaptide report DIR [--json] [--top N] | heaptide snapshot DIR | heaptide diff BASE NEW [--fail-on new|grown|none] | heaptide attach PID [--out DIR]" >&2; exit 2 ;;
esac
out=.work/heaptide; py=0; pyd=1
while [[ $# -gt 0 && $1 != -- ]]; do
  case $1 in --py-depth|--every|--snapshot-every|--out|--gpu-timeline)
    [[ $# -ge 2 && $2 != -- && $2 != --* ]] || { echo "FAIL heaptide: $1 needs a value" >&2; exit 2; }
    [[ $1 == --out || $1 == --gpu-timeline || $2 =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "FAIL heaptide: $1 takes a number, not $2" >&2; exit 2; } ;;
  esac
  case $1 in
    --gpu) export MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_SIZE=0 MODULAR_DEVICE_CONTEXT_HOST_MEMORY_MANAGER_SIZE=0 ;;
    --py) py=1 ;;
    --py-depth) pyd=$2; shift ;;
    --every) export HEAPTIDE_EVERY=$2; shift ;;
    --snapshot-every) export HEAPTIDE_SNAPSHOT_EVERY=$2; shift ;;
    --out) out=$2; shift ;;
    --gpu-timeline) m=0; for x in ${2//,/ }; do case $x in all) m=7;; sites) m=$((m | 1));; streams) m=$((m | 3));; frag) m=$((m | 5));;
                      *) echo "FAIL heaptide: --gpu-timeline takes all or sites,streams,frag, not $x" >&2; exit 2;; esac; done
                    export HEAPTIDE_GPU_TIMELINE=$m; shift ;;
    *) echo "FAIL heaptide: unknown option $1" >&2; exit 2 ;;
  esac
  shift
done
[[ ${1:-} == -- ]] && shift
[[ $# -gt 0 ]] || { echo "FAIL heaptide: no command" >&2; exit 2; }
mkdir -p "$out"; export HEAPTIDE_OUT=$(readlink -f "$out")
if (( py )); then
  export HEAPTIDE_PY=1
  [[ $(basename "$1") == python* ]] || { echo "FAIL heaptide: --py needs a python command" >&2; exit 2; }
  export HEAPTIDE_DEPTH=${HEAPTIDE_DEPTH:-8}  # tracemalloc gives the Python lines; native frames past 8 only split sites
  perf=(); "$1" -c 'import sys; sys.exit(sys.version_info < (3, 12))' 2>/dev/null && perf=(-X perf)  # Python frames in native stacks
  exe=$1; shift; set -- "$exe" "${perf[@]}" -X tracemalloc=$pyd "$here/py/run.py" "$@"
fi
# static ASan (clang's default) defines malloc in the program itself, ahead of any preload
exe=$(command -v "$1" || true)
[[ -n $exe ]] && command -v nm >/dev/null && nm -D --defined-only "$exe" 2>/dev/null | grep -c ' __asan_init$' >/dev/null &&
  echo "heaptide: warning: $1 links ASan statically, heaptide cannot see its allocations; rebuild with -shared-libsan (clang) or gcc -fsanitize=address" >&2
# an ASan-built program refuses to start unless its runtime is preloaded first; heaptide must be,
# and its hooks hand every call on to ASan's, so the order check is turned off (both then work)
[[ ${ASAN_OPTIONS:-} == *verify_asan_link_order* ]] || export ASAN_OPTIONS="${ASAN_OPTIONS:+${ASAN_OPTIONS}:}verify_asan_link_order=0"
rc=0; LD_PRELOAD="$here/build/libheaptide.so${LD_PRELOAD:+:$LD_PRELOAD}" "$@" || rc=$?
echo "heaptide: report with: heaptide report $HEAPTIDE_OUT" >&2
exit $rc
